{
  "name": "@forestfuture/active-record",
  "version": "0.5.1",
  "description": "A Rails-inspired Active Record for Cloudflare Workers, with an adapter per database.",
  "keywords": [
    "active-record",
    "cloudflare",
    "orm",
    "workers"
  ],
  "homepage": "https://d1-record.forestfuture.dev",
  "bugs": {
    "url": "https://github.com/forestfuture/active-record/issues"
  },
  "license": "MIT",
  "author": "ForestFuture (https://forestfuture.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forestfuture/active-record.git",
    "directory": "packages/active-record"
  },
  "bin": {
    "active-record": "./cli/bin.ts",
    "ffar": "./cli/bin.ts"
  },
  "files": [
    "dist",
    "llms-full.txt",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/for-adapters.ts",
    "./cli": "./cli/for-adapters.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "active-record": "./dist/command.mjs",
      "ffar": "./dist/command.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./adapter": "./dist/adapter.mjs",
      "./cli": "./dist/cli.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack && vp run d1-record-site#build && node ../../scripts/pack-docs.mjs",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  }
}
