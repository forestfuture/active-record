{
  "name": "@forestfuture/d1-record",
  "version": "0.5.1",
  "description": "The Cloudflare D1 adapter for @forestfuture/active-record.",
  "keywords": [
    "active-record",
    "cloudflare",
    "d1",
    "orm",
    "sqlite",
    "workers"
  ],
  "homepage": "https://d1-record.forestfuture.dev",
  "bugs": {
    "url": "https://github.com/forestfuture/d1-record/issues"
  },
  "license": "MIT",
  "author": "ForestFuture (https://forestfuture.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forestfuture/d1-record.git",
    "directory": "packages/d1-record"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./cli/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./cli": "./dist/cli.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run @forestfuture/active-record#build && vp pack",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@forestfuture/active-record": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@forestfuture/active-record": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
