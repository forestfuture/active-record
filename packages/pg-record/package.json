{
  "name": "@forestfuture/pg-record",
  "version": "0.6.0",
  "private": true,
  "description": "The Postgres adapter for @forestfuture/active-record, on Workers through Hyperdrive and on Node.",
  "keywords": [
    "active-record",
    "cloudflare",
    "hyperdrive",
    "orm",
    "postgres",
    "workers"
  ],
  "homepage": "https://active-record.forestfuture.dev",
  "bugs": {
    "url": "https://github.com/forestfuture/active-record/issues"
  },
  "license": "MIT",
  "author": "ForestFuture (https://forestfuture.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forestfuture/active-record.git",
    "directory": "packages/pg-record"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./cli/plugin.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./cli": "./dist/cli.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run @forestfuture/active-record#build && vp pack",
    "prepublishOnly": "node ../../scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14"
  },
  "devDependencies": {
    "@forestfuture/active-record": "workspace:*",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4",
    "@forestfuture/active-record": "workspace:*",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  }
}
