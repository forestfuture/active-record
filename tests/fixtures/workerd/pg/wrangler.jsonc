// A Worker on the PostgreSQL adapter, bundled by tests/integration/pg/workerd.test.ts and run in workerd. Its
// DATABASE_URL is the test's own schema, given to Miniflare as a text binding.
{
  "name": "pg-record-workerd",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
}
