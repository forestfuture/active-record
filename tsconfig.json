{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only TypeScript that type stripping can remove, so Node runs the scripts as they are.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // The documentation's examples import the package by name, as an app would.
    "paths": {
      "@forestfuture/active-record": ["./packages/active-record/src/index.ts"],
      "@forestfuture/active-record/adapter": ["./packages/active-record/src/for-adapters.ts"],
      "@forestfuture/active-record/cli": ["./packages/active-record/cli/for-adapters.ts"],
      "@forestfuture/active-record/d1": ["./packages/active-record/src/adapters/d1/index.ts"],
      "@forestfuture/active-record/postgresql": [
        "./packages/active-record/src/adapters/postgresql/index.ts"
      ]
    }
  },
  "include": ["vite.config.ts", "tests", "scripts", "packages/*/vite.config.ts"]
}
