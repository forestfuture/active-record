{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only TypeScript that type stripping can remove, so Node runs the scripts as they are.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    // The documentation's examples import the package by name, as an app would.
    "paths": {
      "@forestfuture/arbor": ["./packages/arbor/src/index.ts"],
      "@forestfuture/arbor/adapter": ["./packages/arbor/src/for-adapters.ts"],
      "@forestfuture/arbor/cli": ["./packages/arbor/cli/for-adapters.ts"],
      "@forestfuture/arbor/d1": ["./packages/arbor/src/adapters/d1/index.ts"],
      "@forestfuture/arbor/postgresql": ["./packages/arbor/src/adapters/postgresql/index.ts"]
    }
  },
  "include": ["vite.config.ts", "tests", "scripts", "packages/*/vite.config.ts"]
}
