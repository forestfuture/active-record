// d1-record.forestfuture.dev, where the guide was until #270: a Worker that redirects every request
// to arbor.forestfuture.dev. It keeps the guide's first Worker name, so deploying it replaces that
// Worker and its route. active-record.wrangler.jsonc deploys the same redirect for the guide's
// second host.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "d1-record-docs",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "d1-record.forestfuture.dev/*", "zone_name": "forestfuture.dev" }],
}
