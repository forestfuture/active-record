// The documentation site: Blume's static build, served at active-record.forestfuture.dev. Its old
// host, d1-record.forestfuture.dev, redirects here (redirect/wrangler.jsonc).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "active-record-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist",
    // Blume writes each page as <route>/index.html and links to it without a trailing slash.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "workers_dev": false,
  // The hostname's proxied DNS record is added once in the Cloudflare dashboard
  // (docs/agents/cloudflare-tokens.md); the route needs only Workers Routes: Edit.
  "routes": [{ "pattern": "active-record.forestfuture.dev/*", "zone_name": "forestfuture.dev" }],
}
