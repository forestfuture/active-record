{
  "name": "active-record-site",
  "private": true,
  "description": "The Active Record documentation site, deployed to active-record.forestfuture.dev.",
  "type": "module",
  "scripts": {
    "dev": "node excerpts.ts && blume dev",
    "build": "node excerpts.ts && blume build && blume validate --strict",
    "preview": "vp run build && wrangler dev",
    "deploy": "vp run build && wrangler deploy",
    "eval": "node excerpts.ts && blume eval --agent claude"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@forestfuture/active-record": "workspace:*",
    "@types/react": "19.3.0",
    "blume": "2.2.7",
    "wrangler": "^4.158.0"
  }
}
