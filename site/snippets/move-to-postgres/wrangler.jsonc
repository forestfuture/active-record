{
  "name": "my-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "<the id it printed>",
      "localConnectionString": "postgres://user:password@localhost:5432/my_app",
    },
  ],
}
