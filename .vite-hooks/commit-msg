# Checks a commit's message: its title's length, and that a tests-only commit
# says its tests are guards.

# Commit titles: aim for 50 characters, warn past 60, never more than 72.
# See "Commit messages" in docs/agents/workflow.md.
title=$(grep -v '^#' "$1" | sed -n '/[^[:space:]]/{p;q;}')
length=${#title}

if [ "$length" -gt 72 ]; then
  echo "Commit title is $length characters; the limit is 72 (aim for 50):"
  echo "  $title"
  echo "Put the detail in the body, after a blank line."
  exit 1
fi

if [ "$length" -gt 60 ]; then
  echo "Warning: commit title is $length characters; aim for 50 or less."
fi

# A commit that stages only tests and adds more than it removes adds
# guards: tests that passed on their first run. See CODING_STANDARDS.md.
# A rename or a move adds as many test calls as it removes.
# On git commit --amend, HEAD is the commit being amended, so the hook sees
# only what the amend changes; git doesn't tell a commit-msg hook it's one.
outside_tests=$(git -c core.quotePath=false diff --cached --name-only --no-renames | grep -v '^tests/' || true)
test_call='(^|[^A-Za-z0-9_.$])(test|it)(\.[A-Za-z]+)*\('
test_diff=$(git diff --cached -U0 --no-color --no-ext-diff -- tests/)
added=$(printf '%s\n' "$test_diff" | grep '^+' | grep -cE "$test_call" || true)
removed=$(printf '%s\n' "$test_diff" | grep '^-' | grep -cE "$test_call" || true)
# Lines that open with git's comment character aren't part of the message,
# and it ends at git commit -v's scissors line; the diff follows it. With
# commentChar set to auto, git's choice isn't known here, so # stands in.
comment=$(git config core.commentString || git config core.commentChar || true)
case "$comment" in '' | auto) comment='#' ;; esac
message=$(awk -v c="$comment" '
  $0 == c " ------------------------ >8 ------------------------" { exit }
  index($0, c) == 1 { next }
  { print }' "$1")
says_guard=$(printf '%s\n' "$message" | grep -iE '(^|[^a-z])guard' || true)

if [ -z "$outside_tests" ] && [ "$added" -gt "$removed" ] && [ -z "$says_guard" ]; then
  echo 'Warning: this commit only adds tests. If they passed on their first run, say "guard" in the body.'
fi
