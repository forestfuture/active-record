# Checks a commit's message: the length of its title, that its body is
# wrapped at 72 (it wraps a line that can wrap), that it holds no invisible
# character, and that a tests-only commit says its tests are guards.

# The C locale, as dash has in any: [[:space:]] means ASCII whitespace, as
# for git, ${#x} counts bytes, and sed reads a byte that isn't UTF-8.
export LC_ALL=C

# Lines that open with git's comment character aren't part of the message,
# which ends at git commit -v's scissors line; the diff follows it. With
# commentChar set to auto, git's choice isn't known here, so # stands in.
# git reads commentChar and commentString as one setting, the last one wins,
# and --get-regexp lists them in the order git reads them.
comment=$(git config --get-regexp '^core\.comment(char|string)$' | tail -n 1 | cut -s -d ' ' -f 2-)
# git reads auto in any case.
case "$comment" in '' | [Aa][Uu][Tt][Oo]) comment='#' ;; esac

# Commit bodies wrap at 72, since git shows them as written. A body line
# of prose past 72 is wrapped here, in the message file, at the spaces
# between its words, which it keeps: a bullet's or a numbered item's
# following lines line up under its text. Lines that aren't prose are
# left as written, and the check below refuses one past 72: a line
# indented four spaces or a tab, as code is, a quoted line, a trailer
# such as Co-authored-by, and a line with a word too long for a line. A
# line that holds a URL is left too. Characters are counted, not bytes:
# in the C locale awk counts bytes, so it drops UTF-8's continuation
# bytes first.
trap 'rm -f "$1.wrapping"' EXIT
wrapped=$(awk -v c="$comment" '
  function characters(text, copy) {
    copy = text
    gsub(/[\200-\277]/, "", copy)
    return length(copy)
  }
  function prose(line) {
    return line !~ /^(\t|    | *>|[A-Za-z]+(-[A-Za-z]+)+: )/ && line !~ /:\/\//
  }
  function wrap(line, lead, hang, rest, count, words, gaps, i, out) {
    match(line, /^ *(([-*+]|[0-9]+[.)]) +)?/)
    lead = substr(line, 1, RLENGTH)
    rest = substr(line, RLENGTH + 1)
    hang = lead
    gsub(/[^ ]/, " ", hang)
    count = 0
    while (rest != "") {
      match(rest, /^[^ \t]+/)
      words[++count] = substr(rest, 1, RLENGTH)
      if (characters(hang words[count]) > 72) return 0
      rest = substr(rest, RLENGTH + 1)
      match(rest, /^[ \t]*/)
      gaps[count] = substr(rest, 1, RLENGTH)
      rest = substr(rest, RLENGTH + 1)
    }
    if (count < 2) return 0
    out = lead words[1]
    for (i = 2; i <= count; i++) {
      if (characters(out gaps[i - 1] words[i]) <= 72) { out = out gaps[i - 1] words[i]; continue }
      print out
      out = hang words[i]
    }
    print out
    return 1
  }
  ended { print; next }
  $0 == c " ------------------------ >8 ------------------------" { ended = 1; print; next }
  index($0, c) == 1 { print; next }
  !titled { if ($0 ~ /[^[:space:]]/) titled = 1; print; next }
  {
    line = $0
    sub(/[[:space:]]+$/, "", line)
    if (characters(line) > 72 && prose(line) && wrap(line)) { changed = 1; next }
    print
  }
  END { if (changed) print "wrapped" > "/dev/stderr" }' "$1" 2>&1 >"$1.wrapping")
if [ "$wrapped" = wrapped ]; then
  cat "$1.wrapping" >"$1"
  echo "Wrapped the commit body at 72 characters."
fi

message=$(awk -v c="$comment" '
  $0 == c " ------------------------ >8 ------------------------" { exit }
  index($0, c) == 1 { next }
  { print }' "$1")

# How many characters $1 holds. wc -c counts bytes, so this drops UTF-8's
# continuation bytes first.
character_count() {
  printf '%s' "$1" | tr -d '\200-\277' | wc -c | tr -d ' '
}

# Commit titles: aim for 50 characters, warn past 60, never more than 72.
# See "Commit messages" in docs/agents/workflow.md. git strips a line's
# trailing whitespace, a carriage return included, after the hook runs.
title=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')
title=${title%"${title##*[![:space:]]}"}
length=$(character_count "$title")

# A refused title doesn't stop the body check, so one amend fixes both.
refused=no

if [ "$length" -gt 72 ]; then
  echo "Commit title is $length characters; the limit is 72 (aim for 50):"
  # printf, unlike echo, shows the title's backslashes as written.
  printf '  %s\n' "$title"
  echo "Put the detail in the body, after a blank line."
  refused=yes
elif [ "$length" -gt 60 ]; then
  echo "Warning: commit title is $length characters; aim for 50 or less."
fi

# A body line still past 72, which couldn't wrap, is listed, so one amend
# fixes them all. Lines are numbered as git stores the message: without
# its comments, from the title, and with each run of blank lines as one.
long_lines=$(printf '%s\n' "$message" | {
  number=0
  past_title=no
  blank=no
  while IFS= read -r line; do
    # Without its trailing whitespace, as for the title.
    line=${line%"${line##*[![:space:]]}"}
    if [ -z "$line" ]; then
      [ "$past_title" = no ] || [ "$blank" = yes ] || number=$((number + 1))
      blank=yes
      continue
    fi
    blank=no
    number=$((number + 1))
    if [ "$past_title" = no ]; then
      past_title=yes
      continue
    fi
    # ${#line} counts bytes, and a line holds no more characters than that.
    [ "${#line}" -gt 72 ] || continue
    # A line can't wrap when it holds a URL, or no space after its indent.
    # Each pattern's opening ( keeps bash from closing $( at its ).
    case "$line" in (*://*) continue ;; esac
    indent=${line%%[![:space:]]*}
    case "${line#"$indent"}" in (*[[:space:]]*) ;; (*) continue ;; esac
    line_length=$(character_count "$line")
    [ "$line_length" -gt 72 ] || continue
    echo "Commit body line $number is $line_length characters; wrap the body at 72:"
    printf '  %s\n' "$line"
  done
})

if [ -n "$long_lines" ]; then
  printf '%s\n' "$long_lines"
  refused=yes
fi

# Invisible characters read as a plain space, a line break or nothing, so
# a message holding one says something other than what it holds: every
# Unicode space but the ASCII one, the line and paragraph separators, and
# the format characters. The ranges, in hex, are the code points
# tests/support/invisible-characters.ts lists. The hook's test compares
# them with that list, and sends each one and the characters on each side
# of every range.
invisible_ranges='a0 ad 600-605 61c 6dd 70f 890-891 8e2 1680 180e 2000-200f
  2028-202f 205f-2064 2066-206f 3000 feff fff9-fffb 110bd 110cd 13430-1343f
  1bca0-1bca3 1d173-1d17a e0001 e0020-e007f'
# awk in the C locale reads bytes, so it decodes the message's UTF-8 from
# od's numbers, and prints each invisible character's line number in the
# message and its code point. It reads the ranges from the environment,
# since some awks refuse a newline in awk -v.
export invisible_ranges
invisible_lines=$(printf '%s\n' "$message" | od -An -v -tu1 | awk '
  function hex(digits, i, n) {
    n = 0
    for (i = 1; i <= length(digits); i++)
      n = n * 16 + index("0123456789abcdef", substr(digits, i, 1)) - 1
    return n
  }
  function report(code, i) {
    for (i = 1; i <= count; i++)
      if (code >= low[i] && code <= high[i]) { printf "%d %04X\n", line, code; return }
  }
  # A byte that breaks a sequence, as one that is not UTF-8 does, starts
  # afresh. Nor is an overlong sequence UTF-8: one that decodes below the
  # least code point of its length.
  function feed(byte) {
    if (need > 0 && byte >= 128 && byte < 192) {
      code = code * 64 + byte - 128
      if (--need == 0 && code >= least) report(code)
      return
    }
    need = 0
    if (byte == 10) line++
    else if (byte >= 194 && byte < 224) { code = byte - 192; need = 1; least = 128 }
    else if (byte >= 224 && byte < 240) { code = byte - 224; need = 2; least = 2048 }
    else if (byte >= 240 && byte < 245) { code = byte - 240; need = 3; least = 65536 }
  }
  BEGIN {
    count = split(ENVIRON["invisible_ranges"], list, " ")
    for (i = 1; i <= count; i++) {
      parts = split(list[i], ends, "-")
      low[i] = hex(ends[1])
      high[i] = parts == 2 ? hex(ends[2]) : low[i]
    }
    line = 1
  }
  { for (f = 1; f <= NF; f++) feed($f + 0) }')

if [ -n "$invisible_lines" ]; then
  printf '%s\n' "$invisible_lines" | while read -r number code; do
    echo "Commit message holds an invisible character, U+$code, in this line:"
    printf '  %s\n' "$(printf '%s\n' "$message" | sed -n "${number}p")"
  done
  echo "Write a plain space, or name the character by its code point."
  refused=yes
fi

if [ "$refused" = yes ]; then
  exit 1
fi

# A commit that stages only tests and adds more than it removes adds
# guards: tests that passed on their first run. See CODING_STANDARDS.md.
# A rename or a move adds as many test calls as it removes.
# On git commit --amend, HEAD is the commit being amended, so the hook sees
# only what the amend changes; git doesn't tell a commit-msg hook it's one.
# --no-renames counts a test moved in from another folder as staging that
# folder too. A pathspec, unlike a list of names, is never quoted.
only_tests=no
git diff --cached --quiet --no-renames --no-ext-diff -- . ':(exclude)tests/' && only_tests=yes
test_call='(^|[^A-Za-z0-9_.$])(test|it)(\.[A-Za-z]+)*\('
test_diff=$(git diff --cached -U0 --no-color --no-ext-diff -- tests/)
added=$(printf '%s\n' "$test_diff" | grep '^+' | grep -cE "$test_call" || true)
removed=$(printf '%s\n' "$test_diff" | grep '^-' | grep -cE "$test_call" || true)
says_guard=$(printf '%s\n' "$message" | grep -iE '(^|[^a-z])guard' || true)

if [ "$only_tests" = yes ] && [ "$added" -gt "$removed" ] && [ -z "$says_guard" ]; then
  echo 'Warning: this commit only adds tests. If they passed on their first run, say "guard" in the body.'
fi
