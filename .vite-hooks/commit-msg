# Checks a commit's message: the length of its title and body lines, and that
# a tests-only commit says its tests are guards.

# Lines that open with git's comment character aren't part of the message,
# which ends at git commit -v's scissors line; the diff follows it. With
# commentChar set to auto, git's choice isn't known here, so # stands in.
# git reads commentChar and commentString as one setting, the last one wins,
# and --get-regexp lists them in the order git reads them.
comment=$(git config --get-regexp '^core\.comment(char|string)$' | tail -n 1 | cut -s -d ' ' -f 2-)
# git reads auto in any case.
case "$comment" in '' | [Aa][Uu][Tt][Oo]) comment='#' ;; esac
message=$(awk -v c="$comment" '
  $0 == c " ------------------------ >8 ------------------------" { exit }
  index($0, c) == 1 { next }
  { print }' "$1")

# Commit titles: aim for 50 characters, warn past 60, never more than 72.
# See "Commit messages" in docs/agents/workflow.md.
title=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')
length=${#title}

if [ "$length" -gt 72 ]; then
  echo "Commit title is $length characters; the limit is 72 (aim for 50):"
  echo "  $title"
  echo "Put the detail in the body, after a blank line."
  exit 1
fi

if [ "$length" -gt 60 ]; then
  echo "Warning: commit title is $length characters; aim for 50 or less."
fi

# Commit bodies wrap at 72, since git shows them as written. Each line past
# 72 is listed, so one amend fixes them all. Lines count from the title, as
# git stores the message, without its comments.
long_lines=$(printf '%s\n' "$message" | {
  number=0
  past_title=no
  while IFS= read -r line; do
    number=$((number + 1))
    if [ "$past_title" = no ]; then
      # The pattern's opening ( keeps bash from closing $( at its ).
      case "$line" in (*[![:space:]]*) past_title=yes ;; esac
      continue
    fi
    [ "${#line}" -gt 72 ] || continue
    # A line can't wrap when it holds a URL, or no space after its indent.
    case "$line" in (*://*) continue ;; esac
    indent=${line%%[![:space:]]*}
    case "${line#"$indent"}" in (*[[:space:]]*) ;; (*) continue ;; esac
    echo "Commit body line $number is ${#line} characters; wrap the body at 72:"
    # printf, unlike echo, shows the line's backslashes as written.
    printf '  %s\n' "$line"
  done
})

if [ -n "$long_lines" ]; then
  printf '%s\n' "$long_lines"
  exit 1
fi

# A commit that stages only tests and adds more than it removes adds
# guards: tests that passed on their first run. See CODING_STANDARDS.md.
# A rename or a move adds as many test calls as it removes.
# On git commit --amend, HEAD is the commit being amended, so the hook sees
# only what the amend changes; git doesn't tell a commit-msg hook it's one.
# --no-renames counts a test moved in from another folder as staging that
# folder too. A pathspec, unlike a list of names, is never quoted.
only_tests=no
git diff --cached --quiet --no-renames --no-ext-diff -- . ':(exclude)tests/' && only_tests=yes
test_call='(^|[^A-Za-z0-9_.$])(test|it)(\.[A-Za-z]+)*\('
test_diff=$(git diff --cached -U0 --no-color --no-ext-diff -- tests/)
added=$(printf '%s\n' "$test_diff" | grep '^+' | grep -cE "$test_call" || true)
removed=$(printf '%s\n' "$test_diff" | grep '^-' | grep -cE "$test_call" || true)
says_guard=$(printf '%s\n' "$message" | grep -iE '(^|[^a-z])guard' || true)

if [ "$only_tests" = yes ] && [ "$added" -gt "$removed" ] && [ -z "$says_guard" ]; then
  echo 'Warning: this commit only adds tests. If they passed on their first run, say "guard" in the body.'
fi
