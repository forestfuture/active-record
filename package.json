  "type": "module",
  "scripts": {
    "build": "vp run @forestfuture/active-record#build && vp run @forestfuture/d1-record#build && vp run @forestfuture/pg-record#build",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "test:remote": "D1_REMOTE_SMOKE=1 vp test --project remote",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:package": "node scripts/check-package.mjs",
    "bench:datetime-reads": "node scripts/bench/datetime-reads.ts",
    "bench:load": "node scripts/bench/load.ts",
    "bench:ordered-reads": "node scripts/bench/ordered-reads.ts",
    "bench:preload": "node scripts/bench/preload-trips.ts",
    "check": "vp check",
    "validate": "node scripts/validate.mjs",
    "release:version": "changeset version && vp fmt",
    "prepare": "vp config",
    "knip": "knip",
    "docs:dev": "vp run d1-record-site#dev",
    "docs:build": "vp run d1-record-site#build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "knip": "^6.39.0",
    "miniflare": "^4.20260730.0",
    "pg": "^8.23.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.147.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
