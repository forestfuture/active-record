{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Generated schemas, committed as tests' fixtures: all of each is output, every table
      // exported as active-record schema writes it.
      "ignore": [
        "tests/fixtures/schema-project/schema.ts",
        "tests/fixtures/DB.ts",
        "tests/fixtures/LOGS.ts",
      ],
      "typescript": {
        "config": [
          "tsconfig.json",
          "packages/active-record/src/tsconfig.json",
          "packages/active-record/cli/tsconfig.json",
          "packages/d1-record/src/tsconfig.json",
          "packages/d1-record/cli/tsconfig.json",
          "tests/tsconfig.json",
        ],
      },
      "ignoreDependencies": ["@arethetypeswrong/core", "publint", "cloudflare"],
      // tests/integration/cli-console-command.test.ts lists a process's children with it.
      "ignoreBinaries": ["pgrep"],
    },
    "packages/active-record": {},
    "packages/d1-record": {
      // Provided by the Workers runtime (#77), and its types, an optional peer the root installs.
      "ignoreDependencies": ["cloudflare", "@cloudflare/workers-types"],
    },
    "site": {
      // Examples reach pages through the excerpts the site's build writes, not through imports;
      // Blume loads its config, components.ts and each group's meta.ts itself. Logo.tsx and
      // orb.ts are imported from .astro files, which knip doesn't read.
      "entry": [
        "snippets/**/*.ts",
        "blume.config.ts",
        "components.ts",
        "components/Logo.tsx",
        "components/orb.ts",
        "docs/**/meta.ts",
      ],
      // Types for Logo.tsx's JSX, which tsconfig.json's "jsx" setting reads without an import.
      "ignoreDependencies": ["@types/react"],
    },
  },
}
